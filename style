body {
  font-family: Arial, sans-serif;
  background: #f8f9fa;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  margin: 0;
}

.container {
  background: white;
  padding: 20px;
  border-radius: 12px;
  box-shadow: 0 4px 10px rgba(0,0,0,0.1);
  text-align: center;
  width: 320px;
}

h2 {
  margin-bottom: 15px;
}

video {
  width: 100%;
  border: 1px solid #ccc;
  border-radius: 8px;
  margin: 10px 0;
}

#result {
  margin: 10px 0;
  font-size: 18px;
  font-weight: bold;
  color: green;
}

.buttons {
  display: flex;
  justify-content: space-between;
  margin-top: 10px;
}

button {
  padding: 10px;
  border: none;
  border-radius: 6px;
  cursor: pointer;
  font-size: 14px;
}

#copyButton {
  background: #007bff;
  color: white;
}

#sendButton {
  background: #28a745;
  color: white;
}
